# Step 1: Use an official Node.js runtime as a parent image to build the React app
FROM node:18 AS build

# Step 2: Set the working directory
WORKDIR /usr/src/app

# Step 3: Copy package.json and package-lock.json to install dependencies
COPY package*.json ./

# Step 4: Install the React dependencies
RUN npm install

# Step 5: Copy the rest of the application code
COPY . .

# Step 6: Build the React app
RUN npm run build

# Step 7: Use a lightweight web server to serve the React app (nginx is a good option)
FROM nginx:alpine

# Step 8: Copy the build folder to the nginx server
COPY --from=build /usr/src/app/dist /usr/share/nginx/html

# Step 9: Expose port 80 for the React app
EXPOSE 80

# Step 10: Command to run nginx server
CMD ["nginx", "-g", "daemon off;"]
